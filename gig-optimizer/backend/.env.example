# Peakr backend — Edge Function secrets (set with `supabase secrets set ...`).
# These are provided to functions automatically by Supabase except VAPID_*.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Community model k-anonymity threshold (min contributors before a cell is published)
K_ANONYMITY=5

# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:ops@peakr.app

# Surge alert floor: only notify when next hour's avg net >= this (cents/hr)
SURGE_FLOOR_CENTS=2500
